#!/usr/bin/env bash
#
# This script builds the ansible-tester image.
#
# © 2025 The Arizona Board of Regents on behalf of The University of Arizona.
# For license information, see https://cyverse.org/license.

set -o errexit -o nounset -o pipefail

EXEC_NAME="$(readlink -f "$0")"
readonly EXEC_NAME

BASE_DIR="$(dirname "$EXEC_NAME")"
readonly BASE_DIR

#shellcheck source=testing/portability.sh
. "$BASE_DIR"/../portability.sh

main()
{
  # Without the Docker driver, buildx leaves the image in its own cache.
  portability::use_docker_builder

  local cfg="$1"

  if [[ -z "$cfg" ]]; then
    printf 'An environment variable include file is needed.\n' >&2
    return 1
  fi

  if ! [[ "$cfg" =~ ^/ ]]; then
    cfg="$(pwd)"/"$cfg"
  fi

  # shellcheck disable=SC1090
  . "$cfg"

  trap 'rm -f "$BASE_DIR"/requirements.txt "$BASE_DIR"/requirements.yml' EXIT
  local req
  for req in requirements.txt requirements.yml; do
    [[ -e "$BASE_DIR"/"$req" ]] || cp "$BASE_DIR"/../../"$req" "$BASE_DIR"/
  done

  local buildArgs=(
#    --no-cache
    --build-arg=IRODS_CLERVER_PASSWORD="$IRODS_CLERVER_PASSWORD"
    --platform=linux/amd64
    --tag=ansible-tester )

  docker buildx build "${buildArgs[@]}" "$BASE_DIR"
}

main "$@"
