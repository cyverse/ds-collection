---
ansible_python_interpreter: /usr/bin/python3

ansible_support_package_manager: yum

irods_default_dir_mode: '0770'
irods_default_file_mode: '0660'

irods_host_aliases:
  - alias-1
  - alias-2

irods_storage_resources:
  - name: replRes
    vault: "{{ irods_default_vault }}"
    context: minimum_free_space_for_create_in_bytes=1048576
  - name: ingestRes
    vault: /var/lib/irods/ingest_vault
    context: minimum_free_space_for_create_in_bytes=1048576
  - name: esiilRes
    vault: /var/lib/irods/esiil_vault
    context: minimum_free_space_for_create_in_bytes=1048576
  - name: ncemsRes
    vault: /var/lib/irods/ncems_vault
    context: minimum_free_space_for_create_in_bytes=1048576
