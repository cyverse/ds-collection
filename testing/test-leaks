help() {
	cat <<EOF

$EXEC_NAME

Usage:
$EXEC_NAME [options] [-- ansible-playbook options]

measure iRODS agent memory leaks caused by PEPs

Options:
 -a, --alma9 <version>  replace the CentOS 7 iRODS 4.3.1 catalog service
                        provider with an AlmaLinux 9 one running iRODS
                        <version>, building its image if needed
 -c, --cases <file>     a vars file of cases to run in place of the default
                        PEPs or workloads, e.g., leak-check/exec_cmd_cases.yml
 -d, --data-store-rules deploy the Data Store's rule bases and measure each
                        workload against them, instead of comparing empty PEPs
                        with control runs under the stock rule bases
 -h, --help             show help and exit
 -o, --output <dir>     the directory to write the results to, default
                        ./leak-check-results

Summary:
This script starts the testing environment, runs
testing/leak-check/leak_check.yml against the configured catalog service
provider, prints a summary of each case's memory growth, and stops the
environment. The results go to <platform>-<version>.json in the output
directory, e.g., alma9-4.3.5.json, alma9-4.3.5-data-store.json with
--data-store-rules, or alma9-4.3.5-exec_cmd_cases.json with --cases. Options
after -- go to ansible-playbook, for example '-- -e leak_check_threshold_mib=32'.
EOF
}


set -o errexit -o nounset -o pipefail

EXEC_NAME="$(readlink -f "$0")"
TESTING_DIR="$(dirname "$EXEC_NAME")"
COLLECTION_DIR="$(dirname "$TESTING_DIR")"
readonly EXEC_NAME TESTING_DIR COLLECTION_DIR

#shellcheck source=testing/portability.sh
source "$TESTING_DIR"/portability.sh

portability::require_bash 4

readonly CFG="$TESTING_DIR"/config.inc
readonly COLLECTION_MOUNT=/root/.ansible/collections/ansible_collections/cyverse/ds

# shellcheck disable=SC1090
source "$CFG"


main() {
	local args
	if ! args="$(portability::getopt a:c:dho: alma9:,cases:,data-store-rules,help,output: "$EXEC_NAME" "$@")"; then
		exit_with_help
	fi

	eval set -- "$args"

	local cases=
	local output=leak-check-results
	local overrides=()
	local platform=centos7-4.3.1
	local rules=stock
	while true; do
		case "$1" in
			-a|--alma9)
				export IRODS_VERSION="$2"
				overrides=("$TESTING_DIR"/env/docker-compose.provider-alma9.yml)
				platform=alma9-"$2"
				shift 2
				;;
			-c|--cases)
				cases="$2"
				shift 2
				;;
			-d|--data-store-rules)
				rules=data_store
				shift 1
				;;
			-h|--help)
				help
				return
				;;
			-o|--output)
				output="$2"
				shift 2
				;;
			--)
				shift 1
				break
				;;
		esac
	done

	local results="$platform".json
	if [[ "$rules" == data_store ]]; then
		results="$platform"-data-store.json
	fi

	local casesMount=()
	if [[ -n "$cases" ]]; then
		if ! [[ -f "$cases" ]]; then
			printf 'The cases file %s does not exist\n' "$cases" >&2
			return 1
		fi

		results="${results%.json}-$(basename "${cases%.*}")".json
		casesMount=(--volume "$(readlink -f "$cases")":/cases.yml:ro)
	fi

	mkdir -p "$output"
	output="$(readlink -f "$output")"

	"$TESTING_DIR"/env/controller "$CFG" start ${overrides[@]+"${overrides[@]}"}
	#shellcheck disable=SC2064
	trap "$(printf '%q ' "$TESTING_DIR"/env/controller "$CFG" stop ${overrides[@]+"${overrides[@]}"})" EXIT

	# The tester runs as root, so hand the results back to the invoking user.
	docker run --rm --interactive \
		--entrypoint bash \
		--env CASES="${cases:+/cases.yml}" \
		--env COLLECTION_MOUNT="$COLLECTION_MOUNT" \
		--env HOST_OWNER="$(id -u):$(id -g)" \
		--env RESULTS="$results" \
		--env RULES="$rules" \
		--network "$DOMAIN" \
		--platform=linux/amd64 \
		--volume "$COLLECTION_DIR":"$COLLECTION_MOUNT":ro \
		--volume "$output":/results \
		${casesMount[@]+"${casesMount[@]}"} \
		ansible-tester \
		-c '
			run() {
				ansible-playbook -i /inventory/hosts-configured /wait-for-ready.yml > /dev/null || return
				if [[ "$RULES" == data_store ]]; then
					deploy_data_store_rules || return
				fi
				ansible-playbook -i /inventory/hosts-configured \
					"$COLLECTION_MOUNT"/testing/leak-check/leak_check.yml \
					-e leak_check_results_file="$RESULTS" -e leak_check_rules="$RULES" \
					${CASES:+-e @"$CASES"} "$@"
			}
			# The same setup the rule tests need; see "The iRODS rule tests".
			deploy_data_store_rules() {
				local playbooks="$COLLECTION_MOUNT"/playbooks
				ansible-playbook -i /inventory/hosts-configured "$playbooks"/irods_cfg.yml \
					&& ansible-playbook --skip-tags=no_testing -i /inventory/hosts-configured \
						"$playbooks"/irods_runtime_init.yml "$playbooks"/dbms_icat.yml
			}
			run "$@"
			rc=$?
			if [[ -e /results/"$RESULTS" ]]; then
				chown "$HOST_OWNER" /results/"$RESULTS"
			fi
			exit $rc' \
		leak-check "$@"
}


exit_with_help() {
	help >&2
	exit 1
}


main "$@"
