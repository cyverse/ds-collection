show_help() {
	cat <<EOF

$ExecName

Usage:
$ExecName [options] [-- ansible-playbook options]

measure iRODS agent memory leaks caused by PEPs

Options:
 -a, --alma9 <version>  replace the CentOS 7 iRODS 4.3.1 catalog service
                        provider with an AlmaLinux 9 one running iRODS
                        <version>, building its image if needed
 -d, --data-store-rules deploy the Data Store's rule bases and measure each
                        workload against them, instead of comparing empty PEPs
                        with control runs under the stock rule bases
 -h, --help             show help and exit
 -o, --output <dir>     the directory to write the results to, default
                        ./leak-check-results

Summary:
This script starts the testing environment, runs
testing/leak-check/leak_check.yml against the configured catalog service
provider, prints a summary comparing each PEP with a control run, and stops the
environment. The results go to <platform>-<version>.json in the output
directory, e.g., alma9-4.3.5.json, or alma9-4.3.5-data-store.json with
--data-store-rules. Options after -- go to ansible-playbook, for
example '-- -e leak_check_threshold_mib=32'.
EOF
}


set -o errexit -o nounset -o pipefail

ExecName=$(readlink -f "$0")
TestingDir=$(dirname "$ExecName")
CollectionDir="$(dirname "$TestingDir")"
readonly ExecName TestingDir CollectionDir

#shellcheck source=testing/portability.inc
source "$TestingDir"/portability.inc

ds_require_bash 4

readonly Cfg="$TestingDir"/config.inc
readonly CollectionMount=/root/.ansible/collections/ansible_collections/cyverse/ds

# shellcheck disable=SC1090
source "$Cfg"


main() {
	local args
	if ! args="$(ds_getopt a:dho: alma9:,data-store-rules,help,output: "$ExecName" "$@")"
	then
		exit_with_help
	fi

	eval set -- "$args"

	local output=leak-check-results
	local overrides=()
	local platform=centos7-4.3.1
	local rules=stock
	while true
	do
		case "$1" in
			-a|--alma9)
				export IRODS_VERSION="$2"
				overrides=("$TestingDir"/env/docker-compose.provider-alma9.yml)
				platform=alma9-"$2"
				shift 2
				;;
			-d|--data-store-rules)
				rules=data_store
				shift 1
				;;
			-h|--help)
				show_help
				return
				;;
			-o|--output)
				output="$2"
				shift 2
				;;
			--)
				shift 1
				break
				;;
		esac
	done

	local results="$platform".json
	if [[ "$rules" == data_store ]]
	then
		results="$platform"-data-store.json
	fi

	mkdir -p "$output"
	output="$(readlink -f "$output")"

	"$TestingDir"/env/controller "$Cfg" start ${overrides[@]+"${overrides[@]}"}
	#shellcheck disable=SC2064
	trap "$(printf '%q ' "$TestingDir"/env/controller "$Cfg" stop ${overrides[@]+"${overrides[@]}"})" EXIT

	# The tester runs as root, so hand the results back to the invoking user.
	docker run --rm --interactive \
		--entrypoint bash \
		--env HOST_OWNER="$(id -u):$(id -g)" \
		--env RESULTS="$results" \
		--env RULES="$rules" \
		--network "$DOMAIN" \
		--platform=linux/amd64 \
		--volume "$CollectionDir":"$CollectionMount":ro \
		--volume "$output":/results \
		ansible-tester \
		-c '
			run() {
				ansible-playbook -i /inventory/hosts-configured /wait-for-ready.yml > /dev/null || return
				if [ "$RULES" = data_store ]; then
					deploy_data_store_rules || return
				fi
				ansible-playbook -i /inventory/hosts-configured \
					'"$CollectionMount"'/testing/leak-check/leak_check.yml \
					-e leak_check_results_file="$RESULTS" -e leak_check_rules="$RULES" "$@"
			}
			# The same setup the rule tests need; see "The iRODS rule tests".
			deploy_data_store_rules() {
				local playbooks='"$CollectionMount"'/playbooks
				ansible-playbook -i /inventory/hosts-configured "$playbooks"/irods_cfg.yml \
					&& ansible-playbook --skip-tags=no_testing -i /inventory/hosts-configured \
						"$playbooks"/irods_runtime_init.yml "$playbooks"/dbms_icat.yml
			}
			run "$@"
			rc=$?
			chown -R "$HOST_OWNER" /results
			exit $rc' \
		leak-check "$@"
}


exit_with_help() {
	show_help >&2
	exit 1
}


main "$@"
