help() {
	cat <<EOF

$EXEC_NAME

Usage:
$EXEC_NAME [options] [module ...]

test the Data Store's iRODS rule logic

Parameters:
 module  the name of a test module in playbooks/tests/rules, with or without
         its .py extension, e.g., cyverse_logic

Options:
 -h, --help                     show help and exit
 -v, --irods-version <version>  run the configured iRODS servers on iRODS
                                <version> instead of 4.3.1, building their
                                images if needed, and pass it to the setup
                                playbooks as irods_version

Summary:
This script starts the testing environment, prepares it for the rule tests,
runs the given test modules, or every module if none are given, reports which
passed, and stops the environment. Each module runs in its own ansible-tester
container. Preparing the environment takes about four minutes on an x86_64
host. It deploys the Data Store's rule bases, creates the rodsadmin group, the
r_transfer_totals table, and the AVRA, ESIIL, NCEMS, and PIRE resources and
collections, and restarts every iRODS server in test mode.

Environment Variables:
 IRODS_VERSION  the iRODS release to run, as with --irods-version, which takes
                precedence
EOF
}


set -o errexit -o nounset -o pipefail

EXEC_NAME="$(readlink -f "$0")"
TESTING_DIR="$(dirname "$EXEC_NAME")"
COLLECTION_DIR="$(dirname "$TESTING_DIR")"
readonly EXEC_NAME TESTING_DIR COLLECTION_DIR

#shellcheck source=testing/portability.sh
source "$TESTING_DIR"/portability.sh
#shellcheck source=testing/data_store_env.sh
source "$TESTING_DIR"/data_store_env.sh
#shellcheck source=testing/irods_crash.sh
source "$TESTING_DIR"/irods_crash.sh
#shellcheck source=testing/irods_version.sh
source "$TESTING_DIR"/irods_version.sh
#shellcheck source=testing/results.sh
source "$TESTING_DIR"/results.sh

portability::require_bash 4

readonly CFG="$TESTING_DIR"/config.inc
readonly RULES_DIR="$COLLECTION_DIR"/playbooks/tests/rules
readonly IRODS_SERVICES=(provider_configured consumer_configured_centos consumer_unconfigured)

# shellcheck disable=SC1090
source "$CFG"


main() {
	local args
	if ! args="$(portability::getopt hv: help,irods-version: "$EXEC_NAME" "$@")"; then
		exit_with_help
	fi

	eval set -- "$args"

	while true; do
		case "$1" in
			-h|--help)
				help
				return
				;;
			-v|--irods-version)
				export IRODS_VERSION="$2"
				shift 2
				;;
			--)
				shift 1
				break
				;;
		esac
	done

	if ! irods_version::check; then
		exit_with_help
	fi

	local modules=("${@%.py}")
	if (( ${#modules[@]} == 0 )); then
		readarray -t modules < <(list_modules)
	fi

	local module
	for module in "${modules[@]}"; do
		if [[ "$module" == test_rules ]] || ! [[ -f "$RULES_DIR"/"$module".py ]]; then
			printf 'There is no rule test module named %s\n' "$module" >&2
			exit 1
		fi
	done

	if ! irods_crash::is_attempt; then
		irods_crash::run_retrying "$EXEC_NAME" "$@"
		return
	fi

	# Set before starting, so a start that fails partway doesn't leave containers behind.
	trap stop_env EXIT
	"$TESTING_DIR"/env/controller "$CFG" start

	prepare_env

	# A module that stops partway can leave a mock rule base deployed, so give
	# each one a fresh container.
	local failed=()
	for module in "${modules[@]}"; do
		printf '\nRunning %s\n' "$module"

		if ! data_store_env::run_in_tester "cd /playbooks-under-test/tests/rules && python $module.py"; then
			failed+=("$module")
		fi
	done

	results::print_summary modules "${#modules[@]}" ${failed[@]+"${failed[@]}"}

	if (( ${#failed[@]} > 0 )); then
		return 1
	fi
}


exit_with_help() {
	help >&2
	exit 1
}


# Writes the names of the test modules, without their .py extensions, to
# stdout. test_rules.py is the library the modules share, not a module.
list_modules() {
	local file
	for file in "$RULES_DIR"/*.py; do
		file="$(basename "$file" .py)"

		if [[ "$file" != test_rules ]]; then
			printf '%s\n' "$file"
		fi
	done
}


# Deploys the Data Store's rule bases and what they depend on, then restarts
# iRODS in test mode so that it writes the test_mode_output.log the tests read.
prepare_env() {
	data_store_env::prepare

	local service
	for service in "${IRODS_SERVICES[@]}"; do
		printf 'Restarting iRODS on %s in test mode\n' "$service"
		docker exec "$ENV_NAME"-"$service"-1 \
			su - irods -c '/var/lib/irods/irodsctl --test restart'
	done
}


stop_env() {
	"$TESTING_DIR"/env/controller "$CFG" stop
}


main "$@"
