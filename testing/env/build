#!/usr/bin/env bash
#
# Usage:
#  build INC_FILE
#
# PARAMETERS:
#  INC_FILE  The absolute path to a file including the build time environment
#            variables. See README.md for details.
#
# Builds the base and compose docker images with the provided configuration values.
#
# © 2025 The Arizona Board of Regents on behalf of The University of Arizona.
# For license information, see https://cyverse.org/license.

set -o errexit -o nounset -o pipefail

EXEC_PATH="$(readlink -f "$0")"
readonly EXEC_PATH

#shellcheck source=testing/portability.sh
. "$(dirname "$EXEC_PATH")"/../portability.sh


main()
{
  local baseDir
  baseDir="$(dirname "$EXEC_PATH")"

  local cfg="$*"

  if [ -z "$cfg" ]; then
    printf 'An environment variable include file is needed.\n' >&2
    return 1
  fi

  if ! [[ "$cfg" =~ ^/ ]]; then
    cfg="$(pwd)"/"$cfg"
  fi

  # shellcheck disable=SC1090
  . "$cfg"

  local os
  for os in alma10 alma9 alma8 alma8-systemd ubuntu2004 ubuntu2204 ubuntu2404; do
    local buildArgs=(
#      --no-cache
      --file="$baseDir"/base/Dockerfile."$os"
      --platform=linux/amd64
      --tag=test-env-base:"$os"
    )

    docker buildx build "${buildArgs[@]}" "$baseDir"
  done

  local composeArgs=(
    --file="$baseDir"/docker-compose.yml
    --project-name="$ENV_NAME"
    build
#    --no-cache
  )

  portability::compose "${composeArgs[@]}"

  # compose only builds missing images, so refresh the versions other runs built
  local tags
  readarray -t tags \
    < <(docker images --format '{{.Tag}}' --filter reference="$ENV_NAME"-provider_configured)

  local tag
  for tag in "${tags[@]}"; do
    # Images from before the version tags are tagged latest.
    if [[ "$tag" =~ ^[0-9]+(\.[0-9]+)+$ && "$tag" != "${IRODS_VERSION:-4.3.1}" ]]; then
      IRODS_VERSION="$tag" portability::compose "${composeArgs[@]}" \
        provider_configured consumer_configured_centos
    fi
  done
}


main "$@"
