#!/usr/bin/env bash
#
# Usage:
#  clean INC_FILE
#
# PARAMETERS:
#  INC_FILE  The absolute path to a file including the build time environment
#            variables. See README.md for details.
#
# Deletes the environment's docker images, and the volumes the containerized
# resource server hosts keep Docker's storage in.


main()
{
  local cfg="$1"

  if [ -z "$cfg" ]
  then
    printf 'An environment variable include file is needed.\n' >&2
    return 1
  fi

  if ! [[ "$cfg" =~ ^/ ]]
  then
    cfg="$(pwd)"/"$cfg"
  fi

  #shellcheck disable=1090
  . "$cfg"

  local images
  readarray -t images \
    < <(docker images --format '{{.Repository}}:{{.Tag}}' --filter reference="$ENV_NAME"-*)

  if [[ -n "${images-}" ]]; then
    docker rmi "${images[@]}"
  fi

  local bases
  readarray -t bases < <(docker images --quiet --filter reference=test-env-base)

  if [[ -n "${bases-}" ]]; then
    docker rmi "${bases[@]}"
  fi

  # The name filter matches any part of a name, so other environments' volumes could match too.
  local volumes
  readarray -t volumes < <(
    docker volume ls --quiet --filter name="$ENV_NAME"-consumer_containerized_ \
      | grep --extended-regexp "^$ENV_NAME-consumer_containerized_[^-]+-(containerd|docker)\$" )

  if [[ -n "${volumes-}" ]]; then
    docker volume rm "${volumes[@]}"
  fi
}


main "$@"
